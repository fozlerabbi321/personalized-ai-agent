# ──────────────────────────────────────────────────────────────────────────────
# Application Settings
# ──────────────────────────────────────────────────────────────────────────────
APP_NAME=Personalized AI Agent
DEBUG=true

# Generate a secure key with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-secure-32-char-hex-key-before-production
ALGORITHM=HS256
# Token expires in 7 days (in minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ──────────────────────────────────────────────────────────────────────────────
# Google Gemini API (FREE tier)
# Get your key → https://aistudio.google.com/app/apikey
# ──────────────────────────────────────────────────────────────────────────────
GOOGLE_API_KEY=your-google-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# ──────────────────────────────────────────────────────────────────────────────
# LangSmith Observability (optional — set to true to enable tracing)
# Get your key → https://smith.langchain.com
# ──────────────────────────────────────────────────────────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your-langsmith-api-key-here
LANGCHAIN_PROJECT=personalized-ai-agent

# ──────────────────────────────────────────────────────────────────────────────
# PostgreSQL Connection
# NOTE: When running via `make dev` (Docker), DATABASE_URL is automatically
# overridden by docker-compose.yml to use the 'postgres' service hostname.
# This URL is for local/non-Docker development only.
# ──────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://ai_agent_user:ai_agent_pass@localhost:5432/ai_agent_db

# ──────────────────────────────────────────────────────────────────────────────
# CORS Allowed Origins (comma-separated, no spaces)
# ──────────────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
